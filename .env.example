# ---- obligatoire
DOMAIN=boutiques.mondomaine.be
SHOPFORGE_BASE_URL=https://boutiques.mondomaine.be
SHOPFORGE_SECRET_KEY=            # python -c "import secrets;print(secrets.token_hex(32))" — ne jamais changer ensuite (chiffre les clés Stripe)
POSTGRES_PASSWORD=               # mot de passe long et aléatoire

# ---- emails (outbox = aucun envoi)
EMAIL_PROVIDER=outbox            # postmark | brevo | smtp | outbox
EMAIL_FROM=boutique@mail.mondomaine.be
POSTMARK_SERVER_TOKEN=
BREVO_API_KEY=
SMTP_URL=                        # smtp://utilisateur:motdepasse@smtp.exemple.com:587

# ---- IA (facultatif)
ANTHROPIC_API_KEY=
SHOPFORGE_AI_BUDGET_USD=5

# ---- suivi des erreurs (facultatif, nécessite pip install sentry-sdk)
SENTRY_DSN=

# Les clés Stripe ne vont PAS ici : chaque commerçant les saisit dans Paiements (chiffrées en base).
