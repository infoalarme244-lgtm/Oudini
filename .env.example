# ---- obligatoire
DOMAIN=boutiques.mondomaine.be
SHOPFORGE_BASE_URL=https://boutiques.mondomaine.be
SHOPFORGE_SECRET_KEY=            # python -c "import secrets;print(secrets.token_hex(32))" — ne jamais changer ensuite (chiffre les clés Stripe)
POSTGRES_PASSWORD=               # mot de passe long et aléatoire

# ---- emails (outbox = aucun envoi)
EMAIL_PROVIDER=outbox            # postmark | brevo | smtp | outbox
EMAIL_FROM=boutique@mail.mondomaine.be
POSTMARK_SERVER_TOKEN=
BREVO_API_KEY=
SMTP_URL=                        # smtp://utilisateur:motdepasse@smtp.exemple.com:587

# ---- IA (facultatif)
ANTHROPIC_API_KEY=
SHOPFORGE_AI_BUDGET_USD=5

# ---- suivi des erreurs (facultatif, nécessite pip install sentry-sdk)
SENTRY_DSN=

# ---- paiements : Stripe Connect (parcours simple — les commerçants connectent leur banque chez Stripe, sans clé)
STRIPE_PLATFORM_SECRET_KEY=      # clé de la PLATEFORME (sk_test_… pour essayer, sk_live_… en production)
STRIPE_PLATFORM_WEBHOOK_SECRET=  # secret de l'endpoint Connect https://<domaine>/webhooks/stripe-connect
# ---- informations légales de la plateforme, reprises dans les mentions légales de chaque boutique
PLATFORM_LEGAL_HOST=             # ex. « ShopForge SRL, Rue …, Bruxelles — serveurs : Hetzner Online GmbH, Gunzenhausen (DE) »
SHOPFORGE_COMPANY_LOOKUP=1       # recherche automatique des entreprises (VIES / Annuaire des entreprises)
